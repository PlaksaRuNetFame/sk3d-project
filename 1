            if stickBtn then stickBtn.Text = "STICK: " .. CFG.StickMode .. " / " .. CFG.StickPos end
            if ui then
                ui.stat.Text = (CFG.Enabled and "ON" or "OFF") .. "  |  combo " .. (CFG.AutoCombo and "ON" or "OFF") ..
                    "  |  " .. (State.target and State.target.plr.Name or "no target") ..
                    "  |  " .. math.floor(ping()) .. "ms" .. (State.losOK and "" or "  |  LOS!")
            end
