    container.BackgroundTransparency = 0.4
    container.BorderSizePixel = 0
    container.Parent = self.Body
    Utils.corner(container, 8)
    Utils.pad(container, 6, 6, 6, 6)

    local search = Instance.new("TextBox")
    search.Size = UDim2.new(1, 0, 0, 22)
    search.BackgroundColor3 = Theme.bg_row
    search.BorderSizePixel = 0
    search.Font = Font.med
    search.TextSize = 10
    search.TextColor3 = Theme.text
    search.PlaceholderText = "поиск..."
    search.PlaceholderColor3 = Theme.text_faint
    search.Text = ""
    search.ClearTextOnFocus = false
    search.Parent = container
    Utils.corner(search, 5)

    local scroll = Instance.new("ScrollingFrame")
    scroll.Size = UDim2.new(1, 0, 1, -28)
    scroll.Position = UDim2.new(0, 0, 0, 26)
    scroll.BackgroundTransparency = 1
    scroll.BorderSizePixel = 0
    scroll.ScrollBarThickness = 3
    scroll.ScrollBarImageColor3 = Theme.accent
    scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    scroll.Parent = container

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 3)
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.Parent = scroll

    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 8)
    end)

    local rows = {}
    local api = { Container = container, Scroll = scroll, Rows = rows }

    function api.Rebuild()
        for _, row in ipairs(rows) do
            row.Frame:Destroy()
        end
        table.clear(rows)

        local filter = search.Text:lower()
        local myRoot = Entity.Root()

        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer then
                if filter == "" or player.Name:lower():find(filter, 1, true) then
                    local rowFrame = Instance.new("TextButton")
                    rowFrame.Size = UDim2.new(1, -6, 0, 22)
                    rowFrame.BackgroundColor3 = Theme.bg_row
                    rowFrame.BackgroundTransparency = 0.4
                    rowFrame.BorderSizePixel = 0
                    rowFrame.Font = Font.med
                    rowFrame.TextSize = 10
                    rowFrame.TextColor3 = Theme.text
                    rowFrame.TextXAlignment = Enum.TextXAlignment.Left
                    rowFrame.Text = "  " .. player.Name
                    rowFrame.Parent = scroll
                    Utils.corner(rowFrame, 5)

                    local record = { Frame = rowFrame, Player = player }
                    rows[#rows + 1] = record

                    rowFrame.MouseButton1Click:Connect(function()
                        Config.PriorityTarget = player
                        Notify.Push("target: " .. player.Name, "success")
                    end)
                    rowFrame.MouseButton2Click:Connect(function()
                        Social.TeleportTo(player)
                    end)

                    task.spawn(function()
                        while Runtime.Running and rowFrame.Parent do
                            task.wait(0.4)
                            local ok, humanoid, root = Entity.IsAlive(player)
                            if ok and myRoot then
                                local distance = (root.Position - myRoot.Position).Magnitude
                                rowFrame.Text = string.format("  %s   %d hp   %dm",
                                    player.Name, math.floor(humanoid.Health), math.floor(distance))
                                rowFrame.TextColor3 = Config.PriorityTarget == player and Theme.accent or Theme.text
                            else
                                rowFrame.Text = "  " .. player.Name .. "   dead"
                                rowFrame.TextColor3 = Theme.text_faint
                            end
                        end
                    end)
                end
            end
        end
    end

    search:GetPropertyChangedSignal("Text"):Connect(function()
        api.Rebuild()
    end)

    api.Rebuild()
    return api
end

