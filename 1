--═══════════════════════════════════════════════════════════════ COMBAT ══

local Combat = {}
Combat.UltFrame = nil

function Combat.CancelEndlag()
    if not Config.EndlagCancel then return end
    task.delay(Config.EndlagTime, function()
        local humanoid = Entity.Humanoid()
        if not humanoid or humanoid.PlatformStand then return end
        if humanoid.FloorMaterial == Enum.Material.Air then return end
        if humanoid:GetState() ~= Enum.HumanoidStateType.Running then
            pcall(function()
                humanoid:ChangeState(Enum.HumanoidStateType.Running)
            end)
        end
    end)
end

function Combat.Swing(target)
    local now = os.clock()
    if now - State.LastM1 > Config.ComboReset then
        State.Combo = 0
    end
    if not Config.ComboInfinite and State.Combo >= Config.ComboHits then
        return
    end

    local jitter = 1 + (math.random() - 0.5) * Config.M1Jitter
    if now - State.LastM1 < Config.M1Delay * jitter then
        return
    end

    State.LastM1 = now
    State.Combo = State.Combo + 1
    State.LastHitPlayer = target.Player
    State.LastHitAt = now

    if Config.Reach then
        pcall(Movement.ApplyReach, target)
    end

    Input.Click()
    Combat.CancelEndlag()
end

function Combat.Feed(target)
    if not Config.ComboFeeder then return false end
    local now = os.clock()
    if now - State.LastFeeder < Config.FeederDelay then return false end

    local ragdolled = Entity.IsRagdolled(target.Character, target.Humanoid)
    local stunned = Entity.IsStunned(target.Character)
    local trigger = (ragdolled and Config.FeederOnRagdoll) or (stunned and Config.FeederOnStun)
    if not trigger then return false end

    State.FeederIndex = (State.FeederIndex % #Config.FeederKeys) + 1
    State.LastFeeder = now
    State.LastSkillAny = now
    Input.Press(Config.FeederKeys[State.FeederIndex])
    return true
end

function Combat.RotateSkills(target, blocking)
    if not Config.AutoSkill then return end
    local now = os.clock()

    if Entity.IsRagdolled(target.Character, target.Humanoid) then return end
    if Entity.IsStunned(target.Character) then return end
    if (now - State.LastSkillAny) < Config.SkillFallback then return end
    if blocking and not Config.GuardBreakOnBlock then return end
    if (now - State.LastSkill) < Config.SkillDelay then return end

    State.SkillIndex = (State.SkillIndex % #Config.SkillKeys) + 1
    State.LastSkill = now
    State.LastSkillAny = now
    Input.Press(Config.SkillKeys[State.SkillIndex])
end

function Combat.FindUltFrame()
    local gui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if not gui then return end
    for _, descendant in ipairs(gui:GetDescendants()) do
        if descendant:IsA("Frame") then
            local name = descendant.Name:lower()
            if name:find("awaken", 1, true)
                or name:find("ult", 1, true)
                or name:find("rage", 1, true)
                or name:find("power", 1, true)
                or name:find("energy", 1, true) then
                Combat.UltFrame = descendant
                return
            end
        end
    end
end

function Combat.UltReady()
    for _, name in ipairs({"Awakening", "Ult", "Ultimate", "Rage", "AwakenValue", "Power", "Energy"}) do
        local value = LocalPlayer:GetAttribute(name)
        if value == nil and LocalPlayer.Character then
            value = LocalPlayer.Character:GetAttribute(name)
        end
        if typeof(value) == "number" then
            if value >= 100 or (value >= 0.99 and value <= 1.01) then
                return true
            end
        elseif value == true then
            return true
        end
    end

    if not Combat.UltFrame or not Combat.UltFrame.Parent then
        Combat.UltFrame = nil
        Combat.FindUltFrame()
    end

    local frame = Combat.UltFrame
    if not frame then return false end
    if frame:IsA("Frame") and frame.Size.X.Scale >= 0.97 then return true end
    for _, descendant in ipairs(frame:GetDescendants()) do
        if descendant:IsA("Frame") and descendant.Size.X.Scale >= 0.97 then
            return true
        end
    end
    return false
end

function Combat.HoldBlock()
    if State.Blocking then return end
    local code = Enum.KeyCode[Config.BlockKey:upper()]
    if not code then return end
    State.Blocking = true
    pcall(function()
        VirtualInput:SendKeyEvent(true, code, false, game)
    end)
    task.delay(0.35, function()
        pcall(function()
            VirtualInput:SendKeyEvent(false, code, false, game)
        end)
        State.Blocking = false
    end)
end

function Combat.Brain(target)
    local now = os.clock()
    if target.Player ~= State.TargetPlayer then
        State.TargetPlayer = target.Player
        State.Combo = 0
    end

    if Config.AutoWalk
        and Config.StickMode == "None"
        and target.Distance > 12
        and now - State.LastWalk > 0.25 then
        State.LastWalk = now
        local humanoid = Entity.Humanoid()
        if humanoid then
            pcall(function()
                humanoid:MoveTo(target.Root.Position)
            end)
        end
    end

    if not Config.AutoCombo then return end

    local blocking = Entity.IsBlocking(target.Character)
    local ragdolled = Entity.IsRagdolled(target.Character, target.Humanoid)
    local incoming = Entity.IsAttacking(target.Player, target.Character)

    if Config.AutoDash
        and not ragdolled
        and target.Distance > Config.DashRange
        and now - State.LastDash > 0.6 then
        State.LastDash = now
        if Config.StickMode == "None" then
            Input.Press(Config.DashKey)
        else
            Input.DashRandom()
        end
    end

    if Config.AutoDodge
        and target.Distance < 20
        and not ragdolled
        and incoming
        and now - State.LastDodge > 0.4 then
        State.LastDodge = now
        if Config.AutoTech then
            Input.DashRandom()
        else
            Input.Press(Config.DodgeKey)
        end
    end

    if Config.AutoCounter
        and target.Distance < Config.CounterRange
        and incoming
        and now - State.LastCounter > Config.CounterCooldown then
        State.LastCounter = now
        Input.Press(Config.CounterKey)
    end

    if Config.AutoBlock and target.Distance < 16 and incoming then
        Combat.HoldBlock()
    end

    if not Combat.Feed(target) then
        Combat.RotateSkills(target, blocking)
    end

    if Config.Awaken
        and now - State.LastAwaken > Config.AwakenDelay
        and Combat.UltReady() then
        State.LastAwaken = now
        Input.Press(Config.AwakenKey)
    end

    if Config.AutoM1 and (State.LosClear or not Config.LOSCheck) then
        Combat.Swing(target)
    end
end

