    tl.HorizontalAlignment = Enum.HorizontalAlignment.Right
    tl.SortOrder = Enum.SortOrder.LayoutOrder
    tl.Parent = toastHolder

    local toasts = {}

    function HM.toast(text, on)
        local f = Instance.new("Frame")
        f.Size = UDim2.fromOffset(0, 28)
        f.BackgroundColor3 = on and Color3.fromRGB(60, 18, 44) or Color3.fromRGB(26, 26, 33)
        f.BackgroundTransparency = 0.1
        f.BorderSizePixel = 0
        f.Parent = toastHolder
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 8)
        c.Parent = f
        local s = Instance.new("UIStroke")
        s.Color = on and Color3.fromRGB(255, 105, 200) or Color3.fromRGB(90, 90, 105)
        s.Thickness = 1
        s.Transparency = 0.5
        s.Parent = f
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -16, 1, 0)
        lbl.Position = UDim2.new(0, 8, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Font = Enum.Font.GothamBold
        lbl.TextSize = 11
        lbl.TextXAlignment = Enum.TextXAlignment.Right
        lbl.TextTransparency = 1
        lbl.TextColor3 = on and Color3.fromRGB(255, 220, 245) or Color3.fromRGB(200, 200, 215)
        lbl.Text = text
        lbl.Parent = f

        tw(f, 0.25, { Size = UDim2.fromOffset(210, 28) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        tw(lbl, 0.25, { TextTransparency = 0 })
        toasts[#toasts + 1] = f

        task.delay(1.7, function()
            tw(f, 0.28, { Size = UDim2.fromOffset(0, 28), BackgroundTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            tw(lbl, 0.24, { TextTransparency = 1 })
            task.delay(0.32, function() pcall(function() f:Destroy() end) end)
        end)
    end

    local tab = Instance.new("TextButton")
