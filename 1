        })
    end

    local function bounce(b)
        local s = b:FindFirstChildOfClass("UIScale")
        if not s then
            s = Instance.new("UIScale")
            s.Parent = b
        end
        s.Scale = 0.9
        tw(s, 0.2, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    end

    local function add(text, get, set)
        local b = Instance.new("TextButton")
        b.Size = UDim2.fromOffset(100, 22)
        b.BackgroundColor3 = OFF_BG
        b.BackgroundTransparency = 1
        b.TextTransparency = 1
        b.BorderSizePixel = 0
        b.Font = Enum.Font.GothamBold
        b.TextSize = 10
        b.TextColor3 = OFF_TXT
        b.Text = text
        b.Parent = list
        local c = Instance.new("UICorner")
        c.CornerRadius = UDim.new(0, 6)
        c.Parent = b

        local rec = { b = b, get = get, on = false, label = text }
        btns[#btns + 1] = rec

        b.MouseEnter:Connect(function()
            if not rec.on then tw(b, 0.12, { BackgroundColor3 = HOV_BG }) end
        end)
        b.MouseLeave:Connect(function()
            if not rec.on then tw(b, 0.12, { BackgroundColor3 = OFF_BG }) end
        end)
        b.MouseButton1Click:Connect(function()
            local v = not get()
            set(v)
            rec.on = v
            setBtnVisual(b, v)
            bounce(b)
            if HM.toast then HM.toast(rec.label .. ": " .. (v and "ON" or "OFF"), v) end
        end)
        return b
    end

    add("FARM", function() return CFG.Enabled end, function(v) CFG.Enabled = v end)
