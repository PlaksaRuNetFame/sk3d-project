local Net = {}

function Net.InstallHook()
    local ok = pcall(function()
        local metatable = getrawmetatable(game)
        local originalNamecall = metatable.__namecall
        setreadonly(metatable, false)

        metatable.__namecall = function(self, ...)
            local method = getnamecallmethod()

            if method == "FireServer" or method == "InvokeServer" then
                if Config.RemoteLog and typeof(self) == "Instance" then
                    print("[HM] " .. method .. " -> " .. self:GetFullName(), ...)
                end
            elseif method == "Raycast" and Config.SilentAim and self == workspace and State.Target then
                local origin, _, params = ...
                if typeof(origin) == "Vector3" then
                    local root = Entity.Root()
                    if root and (origin - root.Position).Magnitude < 20 then
                        local aim = Entity.AimPoint(State.Target)
                        return originalNamecall(self, origin, aim.Position - origin, params)
                    end
                end
            end

            return originalNamecall(self, ...)
        end

        setreadonly(metatable, true)
    end)
    return ok
end

local RemoteCache

function Net.FindRemote()
    if RemoteCache and RemoteCache.Parent then
        return RemoteCache
    end
    RemoteCache = nil
    if Config.RemoteName == "" then return nil end

    for _, descendant in ipairs(Replicated:GetDescendants()) do
        if (descendant:IsA("RemoteEvent") or descendant:IsA("UnreliableRemoteEvent"))
            and descendant.Name == Config.RemoteName then
            RemoteCache = descendant
            return descendant
        end
    end
    return nil
end

function Net.Fire()
    local remote = Net.FindRemote()
    local target = State.Target
    if not remote or not target then return end

    local arg = Config.RemoteArg
    pcall(function()
        if arg == "player" then
            remote:FireServer(target.Player)
        elseif arg == "char" then
            remote:FireServer(target.Character)
        elseif arg == "hrp" then
            remote:FireServer(target.Root)
        elseif arg == "pos" then
            remote:FireServer(target.Root.Position)
        else
            remote:FireServer()
        end
    end)
end

