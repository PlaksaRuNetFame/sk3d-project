    local function setMenu(open)
        MenuOpen = open
        if open then
            root.Visible = true
            tab.Visible = false
            tw(root, 0.38, { GroupTransparency = 0, Position = HOME }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
        else
            tw(root, 0.24, { GroupTransparency = 1, Position = UDim2.new(0, -60, 0.13, 0) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
            task.delay(0.28, function()
                if not MenuOpen then root.Visible = false end
            end)
            task.delay(0.16, function()
                if not MenuOpen then
                    tab.Visible = true
                    tab.Size = UDim2.fromOffset(28, 28)
                    tw(tab, 0.25, { Size = UDim2.fromOffset(40, 40) }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
                end
            end)
        end
    end

