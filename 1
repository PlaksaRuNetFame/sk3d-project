local Loops = {}

function Loops.Install()
    Targeting.RefreshSafe()

    task.spawn(function()
        while Runtime.Running do
            task.wait(3)
            Targeting.RefreshSafe()
        end
    end)

    RootMaid:Give(workspace.DescendantAdded:Connect(function(instance)
        if instance:IsA("BasePart") and Config.HitboxScale ~= 1
            and Visuals.IsHitboxName(instance.Name) then
            pcall(Visuals.ArmHitbox, instance)
        end

        if Config.VFXCull then
            if VFX_CLASSES[instance.ClassName] then
                instance.Enabled = false
            end
            if instance:IsA("Explosion") then
                instance.Visible = false
            end
        end
    end))

    task.spawn(function()
        while Runtime.Running do
            task.wait(Config.HitboxSweep)
            if Config.HitboxScale ~= 1 then
                for _, descendant in ipairs(workspace:GetDescendants()) do
                    if descendant:IsA("BasePart") then
                        pcall(Visuals.ExpandHitbox, descendant)
                    end
                end
            end
        end
    end)

    task.spawn(function()
        while Runtime.Running do
            task.wait(0.12)
            local myRoot = Entity.Root()
            if myRoot then
                local myPosition = myRoot.Position
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer then
                        local character = player.Character
                        local humanoid = Entity.HumOf(character)
                        local root = Entity.RootOf(character)
                        if humanoid and root
                            and (root.Position - myPosition).Magnitude <= Config.Range * 1.5 then
                            local current = {}
                            local previous = AnimSeen[player] or {}
                            for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
                                local animation = track.Animation
                                if animation and not Entity.IsIdleAnim(player, animation) then
                                    current[animation.AnimationId] = true
                                    if not previous[animation.AnimationId] then
                                        AttackAt[player] = os.clock()
                                    end
                                end
                            end
                            AnimSeen[player] = current
                        end
                    end
                end
            end
        end
    end)

    RootMaid:Give(RunService.Heartbeat:Connect(function()
        if not Runtime.Running then return end

        if not Config.Enabled then
            Movement.DropAlign()
            Movement.DropWall()
            return
        end

        local character = Entity.Character()
        local humanoid = Entity.Humanoid()
        local ragdolled = (character and humanoid and Entity.IsRagdolled(character, humanoid)) and true or false
        State.Ragdolled = ragdolled

        if AlignRig then
            AlignRig.Position.Enabled = not ragdolled
            AlignRig.Orientation.Enabled = not ragdolled
        end

        local target = State.Target
        if not target or not target.Root.Parent then
            Movement.DropAlign()
            Movement.DropWall()
            return
        end

        if not ragdolled then
            pcall(Movement.ApplyStick, target)
        end
        pcall(Movement.UpdateWall, target)

        if Config.LockCam and not ragdolled then
            local camera = workspace.CurrentCamera
            if camera then
                camera.CFrame = camera.CFrame:Lerp(
                    CFrame.lookAt(camera.CFrame.Position, Movement.Predict(Entity.AimPoint(target))),
                    0.5
                )
            end
        end
    end))

    task.spawn(function()
        while Runtime.Running do
            task.wait(0.07)
            if Config.Enabled then
                local target = Targeting.Acquire()
                State.Target = target
                State.LosClear = (not target) or (not Config.LOSCheck) or Targeting.HasLineOfSight(target)
            else
                State.Target = nil
                State.LosClear = true
            end
        end
    end)

    task.spawn(function()
        while Runtime.Running do
            task.wait(0.02)
            if Config.Enabled then
                local target = State.Target
                if target and target.Root.Parent and target.Humanoid.Health > 0 then
                    pcall(Combat.Brain, target)
                end
            end
        end
    end)

    task.spawn(function()
        while Runtime.Running do
            task.wait(0.1)
            local humanoid = Entity.Humanoid()
            local character = Entity.Character()
            if humanoid and character then
                if Config.AntiRagdoll and humanoid.PlatformStand then
                    pcall(function() humanoid.PlatformStand = false end)
                end

                if Config.AntiStun then
                    local st = humanoid:GetState()
                    if st == Enum.HumanoidStateType.Physics
                        or st == Enum.HumanoidStateType.FallingDown then
                        pcall(function()
                            humanoid:ChangeState(Enum.HumanoidStateType.Running)
                        end)
                    end
                    if humanoid.WalkSpeed < 8 and not humanoid.PlatformStand then
                        humanoid.WalkSpeed = 16
                    end
                end

                if Config.NoFatigue then
                    humanoid.UseJumpPower = true
                    if humanoid.JumpPower < Config.JumpPower then
                        humanoid.JumpPower = Config.JumpPower
                    end
                end

                if Config.AntiFling then
                    local root = Entity.RootOf(character)
                    if root and root.AssemblyLinearVelocity.Magnitude > 250 then
                        root.AssemblyLinearVelocity = root.AssemblyLinearVelocity * 0.15
                    end
                end

                if Config.AntiVoid and character:GetPivot().Y < -80 then
                    pcall(function() LocalPlayer:LoadCharacter() end)
                end

                if Config.WalkSpeed > 0 then
                    humanoid.WalkSpeed = Config.WalkSpeed
                end

                if Config.AnimSpeed ~= 1 then
                    for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
                        local animation = track.Animation
                        if animation and not Entity.IsIdleAnim(LocalPlayer, animation)
                            and track.Speed ~= Config.AnimSpeed then
                            track.Speed = Config.AnimSpeed
                        end
                    end
                end

                if Config.AutoRespawn and humanoid.Health <= 0 then
                    task.wait(1)
                    pcall(function() LocalPlayer:LoadCharacter() end)
                end
            end
        end
    end)

    task.spawn(function()
        while Runtime.Running do
            task.wait(1)
            if Config.Enabled and Config.ResetStreakAt > 0 then
                local stats = LocalPlayer:FindFirstChild("leaderstats")
                if stats then
                    for _, value in ipairs(stats:GetChildren()) do
                        if value:IsA("ValueBase") and value.Name:lower():find("streak", 1, true) then
                            local amount = tonumber(value.Value)
                            if amount and amount >= Config.ResetStreakAt then
                                pcall(function() LocalPlayer:LoadCharacter() end)
                            end
                        end
                    end
                end
            end
        end
    end)

    task.spawn(function()
        while Runtime.Running do
            task.wait(Config.RemoteRate)
            if Config.Enabled and Config.RemoteMode then
                pcall(Net.Fire)
            end
        end
    end)

    task.spawn(function()
        while Runtime.Running do
            task.wait(Config.CullRate)
            if Config.VFXCull then
                for _, descendant in ipairs(workspace:GetDescendants()) do
                    if VFX_CLASSES[descendant.ClassName] and descendant.Enabled then
                        descendant.Enabled = false
                    end
                end
                Visuals.ApplyLightingCull()
            end
        end
    end)

    task.spawn(function()
        while Runtime.Running do
            task.wait(0.5)
            if Config.ESPChams then
                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer then
                        Visuals.SetChams(player, true)
                    end
                end
            else
                for player in pairs(ChamCache) do
                    Visuals.SetChams(player, false)
                end
            end
        end
    end)

    task.spawn(function()
        while Runtime.Running do
            task.wait(0.25)
            if Config.Watermark and not Visuals.WatermarkGui then
                Visuals.SetWatermark(true)
            elseif not Config.Watermark and Visuals.WatermarkGui then
                Visuals.SetWatermark(false)
            end
        end
    end)

    RootMaid:Give(RunService.RenderStepped:Connect(function()
        if not Runtime.Running then return end
        pcall(Visuals.UpdateEsp)
        pcall(Visuals.UpdateWatermark)
        pcall(Movement.StepFly)
    end))

    RootMaid:Give(RunService.Stepped:Connect(function()
        if not Runtime.Running then return end
        if Config.Noclip then
            pcall(Movement.SetNoclip, true)
        elseif next(NoclipSaved) then
            pcall(Movement.SetNoclip, false)
        end
    end))

    task.spawn(function()
        while Runtime.Running do
            task.wait(0.05)
            if Config.Fly ~= State.Flying then
                pcall(Movement.SetFly, Config.Fly)
            end
        end
    end)

    RootMaid:Give(UserInput.JumpRequest:Connect(function()
        if not Config.InfiniteJump then return end
        local humanoid = Entity.Humanoid()
        if humanoid and humanoid:GetState() ~= Enum.HumanoidStateType.Jumping then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end))
end

--══════════════════════════════════════════════════════════════ HOTKEYS ══

local Hotkeys = {}

function Hotkeys.Install()
    RootMaid:Give(UserInput.InputBegan:Connect(function(input, processed)
        if processed then return end
        local key = input.KeyCode

        if key == Enum.KeyCode.F2 then
            Config.Enabled = not Config.Enabled
            Notify.Push("ФАРМ: " .. (Config.Enabled and "ON" or "OFF"), Config.Enabled and "success" or "warn")
        elseif key == Enum.KeyCode.C then
            Config.AutoCombo = not Config.AutoCombo
            Notify.Push("AUTO COMBO: " .. (Config.AutoCombo and "ON" or "OFF"), Config.AutoCombo and "success" or "warn")
        elseif key == Enum.KeyCode.F3 then
            local order = {"LowestHP", "Nearest", "Farthest", "HighestHP"}
            local index = 1
            for i, value in ipairs(order) do
                if value == Config.Mode then index = i end
            end
            Config.Mode = order[(index % #order) + 1]
            Notify.Push("режим: " .. Config.Mode, "info")
        elseif key == Enum.KeyCode.F4 then
            local order = {"Physics", "Hard", "None"}
            local index = 1
            for i, value in ipairs(order) do
                if value == Config.StickMode then index = i end
            end
            Config.StickMode = order[(index % #order) + 1]
            Notify.Push("стик: " .. Config.StickMode, "info")
        elseif key == Enum.KeyCode.F5 then
            Config.SilentAim = not Config.SilentAim
            Notify.Push("SILENT AIM: " .. (Config.SilentAim and "ON" or "OFF"), "info")
        elseif key == Enum.KeyCode.F6 then
            Config.VFXCull = not Config.VFXCull
            Notify.Push("VFX CULL: " .. (Config.VFXCull and "ON" or "OFF"), "info")
        elseif key == Enum.KeyCode.F7 then
            Config.RemoteLog = not Config.RemoteLog
            print("[HM] remote log: " .. tostring(Config.RemoteLog))
        elseif key == Enum.KeyCode.F8 then
            Config.Enabled = false
            Notify.Push("ФАРМ: OFF", "warn")
        elseif key == Enum.KeyCode.F9 then
            local order = {"Behind", "Front", "Side", "Above"}
            local index = 1
            for i, value in ipairs(order) do
                if value == Config.StickPos then index = i end
            end
            Config.StickPos = order[(index % #order) + 1]
            Notify.Push("точка стика: " .. Config.StickPos, "info")
        elseif key == Enum.KeyCode.F10 then
            Config.ESP = not Config.ESP
            Notify.Push("ESP: " .. (Config.ESP and "ON" or "OFF"), "info")
        elseif key == Enum.KeyCode.F11 then
            ConfigManager.Save(Config.ActiveSlot)
            Notify.Push("конфиг сохранён", "success")
        end
    end))
end

