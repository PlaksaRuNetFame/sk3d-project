local function ping()
    local ok, p = pcall(function() return LP:GetNetworkPing() end)
    if ok and p then return p * 1000 end
    local ok2, v = pcall(function() return Stats.Network.ServerStatsItem["Data Ping"]:GetValue() end)
    if ok2 and v then return v end
    return 60
end

local function attrBool(inst, names)
    for _, n in ipairs(names) do
        local v = inst:GetAttribute(n)
        if v ~= nil then return v == true end
    end
    for _, n in ipairs(names) do
        local f = inst:FindFirstChild(n)
        if f then
            if f:IsA("BoolValue") then return f.Value end
            return true
        end
    end
    return false
end

local ATK_ATTR = {"Attacking", "InCombo", "IsAttacking", "UsingMove", "Dashing", "MoveActive"}

local function isBlocking(char) return attrBool(char, {"Blocking", "Block", "IsBlocking", "Guarding", "Blocked"}) end

local function isRagdolled(char, hum)
    if attrBool(char, {"Ragdoll", "Ragdolled", "IsRagdoll", "Stunned", "Stun"}) then return true end
    if hum and hum.PlatformStand then return true end
    if hum and hum:GetState() == Enum.HumanoidStateType.Physics then return true end
    return false
end

local function isStunned(char) return attrBool(char, {"Stunned", "Stun", "Staggered", "HitStun"}) end

local function isAttacking(p, char)
    if attrBool(char, ATK_ATTR) then return true end
    local t0 = attackStart[p]
    if t0 and (os.clock() - t0) <= CFG.AttackWindow then return true end
    return false
end

local function isFriend(p)
    local v = friendCache[p]
    if v == nil then
        local ok, r = pcall(function() return LP:IsFriendsWith(p.UserId) end)
        v = ok and r or false
        friendCache[p] = v
    end
    return v
end

local function isWhitelisted(p)
    if CFG.Whitelist[p.Name] or CFG.Whitelist[p.UserId] then return true end
    if CFG.FriendsWhitelist and isFriend(p) then return true end
    return false
end

local function refreshSafe()
    table.clear(safeParts)
    for _, d in ipairs(workspace:GetChildren()) do
        if d:IsA("BasePart") then
            local n = d.Name:lower()
            if n:find("safe") or n:find("spawn") or n:find("lobby") then
                safeParts[#safeParts + 1] = d
            end
        end
    end
    local sp = workspace:FindFirstChildOfClass("SpawnLocation")
    if sp then safeParts[#safeParts + 1] = sp end
end

local function inSafe(pos)
    for _, p in ipairs(safeParts) do
        local r = math.max(p.Size.Magnitude * 0.5, 38)
        if (p.Position - pos).Magnitude <= r then return true end
    end
    return false
end

local function isImmune(p, hum, char)
    if attrBool(char, {"Invulnerable", "Immune", "SpawnProtection", "IFrames", "SpawnImmunity"}) then return true end
    local t0 = spawnClock[p]
    if t0 and (os.clock() - t0) < 2.5 and hum.Health >= hum.MaxHealth then return true end
    return false
end

local function snapshotIdles(p)
    local c = p.Character
    local h = humOf(c)
    if not h then return end
    local set = {}
    for _, tr in ipairs(h:GetPlayingAnimationTracks()) do
        if tr.Animation then set[tr.Animation.AnimationId] = true end
    end
    idleAnims[p] = set
    lastTracks[p] = {}
end

local function nonIdleTracks(h, p)
    local set = {}
    local idle = idleAnims[p]
    for _, tr in ipairs(h:GetPlayingAnimationTracks()) do
        local id = tr.Animation and tr.Animation.AnimationId
        if id and not (idle and idle[id]) then set[id] = true end
    end
    return set
end

