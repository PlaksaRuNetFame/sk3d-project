function UI:Toggle(props)
    local row = self:Row(26)
    self:RowLabel(row, props.text)

    local pill = Instance.new("TextButton")
    pill.AnchorPoint = Vector2.new(1, 0.5)
    pill.Size = UDim2.fromOffset(38, 18)
    pill.Position = UDim2.new(1, 0, 0.5, 0)
    pill.BackgroundColor3 = Theme.bg_row
    pill.BorderSizePixel = 0
    pill.Text = ""
    pill.Parent = row
    Utils.corner(pill, 9)

    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(14, 14)
    knob.Position = UDim2.new(0, 2, 0.5, -7)
    knob.BackgroundColor3 = Theme.text_faint
    knob.BorderSizePixel = 0
    knob.Parent = pill
    Utils.corner(knob, 7)

    local widget = { State = false, Row = row }

    local function paint(value)
        widget.State = value
        Utils.tween(pill, 0.16, {
            BackgroundColor3 = value and Theme.accent_dim or Theme.bg_row,
        })
        Utils.tween(knob, 0.16, {
            Position = value and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
            BackgroundColor3 = value and Theme.accent or Theme.text_faint,
        })
    end

    local setter = bindFlag(props.flag, function(value)
        if props.callback then props.callback(value) end
    end)

    pill.MouseButton1Click:Connect(function()
        local value = not widget.State
        if setter then
            setter(value)
        end
        paint(value)
        Notify.Push((props.text or "") .. ": " .. (value and "ON" or "OFF"), value and "success" or "info")
    end)

    local initial = props.default
    if props.flag then
        initial = Config[props.flag]
    end
    paint(initial == true)

    widget.Set = function(value)
        if setter then setter(value) end
        paint(value)
    end

    self.Widgets[#self.Widgets + 1] = widget
    return widget
end

