local ultFrame = nil
local function findUlt()
    local pg = LP:FindFirstChildOfClass("PlayerGui")
    if not pg then return end
    for _, d in ipairs(pg:GetDescendants()) do
        if d:IsA("Frame") then
            local n = d.Name:lower()
            if n:find("awaken") or n:find("ult") or n:find("rage") or n:find("power") or n:find("energy") then
                ultFrame = d
                return
            end
        end
    end
end

local function ultReady()
    for _, n in ipairs({"Awakening", "Ult", "Ultimate", "Rage", "AwakenValue", "Power", "Energy"}) do
        local v = LP:GetAttribute(n)
        if v == nil and LP.Character then v = LP.Character:GetAttribute(n) end
        if typeof(v) == "number" then
            if v >= 100 or (v >= 0.99 and v <= 1.01) then return true end
        elseif v == true then
            return true
        end
    end
    if not ultFrame or not ultFrame.Parent then ultFrame = nil findUlt() end
    if not ultFrame then return false end
    if ultFrame:IsA("Frame") and ultFrame.Size.X.Scale >= 0.97 then return true end
    for _, c in ipairs(ultFrame:GetDescendants()) do
        if c:IsA("Frame") and c.Size.X.Scale >= 0.97 then return true end
    end
    return false
end

local function aimPoint(t)
    if CFG.AimPart ~= "" then
        local p = t.char:FindFirstChild(CFG.AimPart)
