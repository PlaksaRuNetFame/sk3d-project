    button.BorderSizePixel = 0
    button.Font = Font.bold
    button.TextSize = 10
    button.TextColor3 = Theme.text
    button.Text = props.default or "None"
    button.Parent = row
    Utils.corner(button, 5)

    if props.flag then
        Config[props.flag] = props.default
    end

    local listening = false
    local widget = { Key = props.default, Callback = props.callback, Text = props.text }

    local function setKey(key)
        widget.Key = key
        button.Text = key or "None"
        if props.flag then
            Config[props.flag] = key
        end
    end

    button.MouseButton1Click:Connect(function()
        listening = true
        button.Text = "..."
    end)

    RootMaid:Give(UserInput.InputBegan:Connect(function(input, processed)
        if listening then
            if input.UserInputType == Enum.UserInputType.Keyboard then
                listening = false
                setKey(input.KeyCode.Name)
                button.TextColor3 = Theme.accent
                task.delay(0.15, function()
                    button.TextColor3 = Theme.text
                end)
            end
            return
        end

        if processed then return end
        if not widget.Key or widget.Key == "None" then return end
        if input.KeyCode.Name ~= widget.Key then return end
        if widget.Callback then
            widget.Callback()
        end
    end))

    setKey(props.default)
    KeybindRegistry[#KeybindRegistry + 1] = widget
    return widget
end

