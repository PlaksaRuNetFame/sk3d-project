local Entity = {}

function Entity.Character()
    return LocalPlayer.Character
end

function Entity.Root()
    local character = LocalPlayer.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

function Entity.Humanoid()
    local character = LocalPlayer.Character
    return character and character:FindFirstChildOfClass("Humanoid")
end

function Entity.HumOf(character)
    return character and character:FindFirstChildOfClass("Humanoid")
end

function Entity.RootOf(character)
    return character and character:FindFirstChild("HumanoidRootPart")
end

function Entity.IsAlive(player)
    local character = player.Character
    if not character then return false end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root then return false end
    if humanoid.Health <= 0 then return false end
    return true, humanoid, root
end

function Entity.IsBlocking(character)
    return Utils.attrBool(character, BLOCK_ATTR)
end

function Entity.IsStunned(character)
    return Utils.attrBool(character, STUN_ATTR)
end

function Entity.IsRagdolled(character, humanoid)
    if Utils.attrBool(character, RAG_ATTR) then return true end
    if humanoid and humanoid.PlatformStand then return true end
    if humanoid and humanoid:GetState() == Enum.HumanoidStateType.Physics then return true end
    return false
end

function Entity.IsImmune(player, humanoid, character)
    if Utils.attrBool(character, IMMUNE_ATTR) then return true end
    local spawnedAt = SpawnAt[player]
    if spawnedAt and (os.clock() - spawnedAt) < 2.5 and humanoid.Health >= humanoid.MaxHealth then
        return true
    end
    return false
end

function Entity.IsFriend(player)
    local cached = FriendCache[player]
    if cached == nil then
        local ok, result = pcall(function()
            return LocalPlayer:IsFriendsWith(player.UserId)
        end)
        cached = ok and result or false
        FriendCache[player] = cached
    end
    return cached
end

function Entity.IsWhitelisted(player)
    if Config.Whitelist[player.Name] or Config.Whitelist[player.UserId] then
        return true
    end
    if Config.FriendsWhitelist and Entity.IsFriend(player) then
        return true
    end
    return false
end

function Entity.AimPoint(target)
    if Config.AimPart ~= "" then
        local part = target.Character:FindFirstChild(Config.AimPart)
        if part and part:IsA("BasePart") then
            return part
        end
    end
    return target.Root
end

function Entity.IsIdleAnim(player, animation)
    if not animation then return true end
    local name = animation.Name:lower()
    if IDLE_NAMES[name] then return true end
    for _, hint in ipairs(IDLE_HINTS) do
        if name:find(hint, 1, true) then return true end
    end
    local learned = IdleIds[player]
    return learned ~= nil and learned[animation.AnimationId] == true
end

function Entity.MarkAttack(player, track)
    local animation = track.Animation
    if not animation then return end
    if Entity.IsIdleAnim(player, animation) then return end
    AttackAt[player] = os.clock()
end

function Entity.IsAttacking(player, character)
    if Utils.attrBool(character, ATK_ATTR) then return true end
    local at = AttackAt[player]
    return at ~= nil and (os.clock() - at) <= Config.AttackWindow
end

function Entity.LearnIdle(player)
    local character = player.Character
    local humanoid = Entity.HumOf(character)
    if not humanoid then return end

    local learned = IdleIds[player]
    if not learned then
        learned = {}
        IdleIds[player] = learned
    end

    for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
        local animation = track.Animation
        if animation then
            local name = animation.Name:lower()
            if IDLE_NAMES[name] then
                learned[animation.AnimationId] = true
            end
        end
    end
end

function Entity.HookAnimator(player, character)
    task.spawn(function()
        local animator = character:FindFirstChildOfClass("Animator")
        if not animator then
            local ok, result = pcall(function()
                return character:WaitForChild("Animator", 6)
            end)
            animator = ok and result or nil
        end
        if not animator or not animator.Parent then return end
        maidFor(player):Give(animator.AnimationPlayed:Connect(function(track)
            Entity.MarkAttack(player, track)
        end))
    end)
end

function Entity.WatchCharacter(player, character)
    if not character then return end
    local maid = maidFor(player)

    maid:Give(character.ChildAdded:Connect(function(child)
        local name = child.Name:lower()
        for _, hint in ipairs(VFX_NAME_HINTS) do
            if name:find(hint, 1, true) then
                AttackAt[player] = os.clock()
                return
            end
        end
    end))

    local humanoid = Entity.HumOf(character)
    if humanoid then
        maid:Give(humanoid.Died:Connect(function()
            if State.LastHitPlayer ~= player then return end
            if (os.clock() - State.LastHitAt) > 4 then return end
            State.Combo = 0
            if Config.Toxic then
                Social.Say(Config.ToxicMsgs[math.random(#Config.ToxicMsgs)])
            end
        end))
    end

    Entity.HookAnimator(player, character)
end

function Entity.OnCharacter(player, character)
    SpawnAt[player] = os.clock()
    maidFor(player):Clean()
    Entity.WatchCharacter(player, character)

    if player == LocalPlayer then
        Movement.DropAlign()
        State.Blocking = false
        State.Combo = 0
        task.wait(0.6)
        local humanoid = Entity.HumOf(character)
        if humanoid then
            humanoid.AutoRotate = true
        end
        task.wait(1.2)
    else
        task.wait(0.25)
    end

    Entity.LearnIdle(player)

    for _ = 1, 12 do
        task.wait(0.5)
        if not Runtime.Running or player.Character ~= character then
            break
        end
        Entity.LearnIdle(player)
    end
end

--═══════════════════════════════════════════════════════════ TARGETING ══

local Targeting = {}

function Targeting.RefreshSafe()
    table.clear(SafeParts)
    for _, child in ipairs(workspace:GetChildren()) do
        if child:IsA("BasePart") then
            local name = child.Name:lower()
            if name:find("safe", 1, true)
                or name:find("spawn", 1, true)
                or name:find("lobby", 1, true) then
                SafeParts[#SafeParts + 1] = child
            end
        end
    end
    local spawnPart = workspace:FindFirstChildOfClass("SpawnLocation")
    if spawnPart then
        SafeParts[#SafeParts + 1] = spawnPart
    end
end

function Targeting.InSafe(position)
    for _, part in ipairs(SafeParts) do
        local radius = math.max(part.Size.Magnitude * 0.5, 38)
        if (part.Position - position).Magnitude <= radius then
            return true
        end
    end
    return false
end

function Targeting.PassesFilters(player, humanoid, character, root, myPosition)
    if Config.SafeZoneFilter and Targeting.InSafe(root.Position) then
        return false
    end
    if Config.ImmunityFilter and Entity.IsImmune(player, humanoid, character) then
        return false
    end
    local distance = (root.Position - myPosition).Magnitude
    if distance > Config.Range then
        return false
    end
    return true, distance
end

function Targeting.Acquire()
    local myRoot = Entity.Root()
    if not myRoot then return nil end
    local myPosition = myRoot.Position

    if Config.PriorityTarget then
        local player = Config.PriorityTarget
        local ok, humanoid, root = Entity.IsAlive(player)
        if ok and (root.Position - myPosition).Magnitude <= Config.Range * 1.6 then
            return {
                Player = player,
                Character = player.Character,
                Humanoid = humanoid,
                Root = root,
                Distance = (root.Position - myPosition).Magnitude,
            }
        end
    end

    local best, bestKey

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and not Entity.IsWhitelisted(player) then
            local ok, humanoid, root = Entity.IsAlive(player)
            if ok then
                local passes, distance = Targeting.PassesFilters(
                    player, humanoid, player.Character, root, myPosition
                )
                if passes then
                    local key
                    if Config.Mode == "Nearest" then
                        key = distance
                    elseif Config.Mode == "Farthest" then
                        key = -distance
                    elseif Config.Mode == "HighestHP" then
                        key = -humanoid.Health
                    else
                        key = humanoid.Health
                    end
                    if not bestKey or key < bestKey then
                        bestKey = key
                        best = {
                            Player = player,
                            Character = player.Character,
                            Humanoid = humanoid,
                            Root = root,
                            Distance = distance,
                        }
                    end
                end
            end
        end
    end

    return best
end

function Targeting.EnsureParams()
    if LosParams then return LosParams end
    LosParams = RaycastParams.new()
    local ok = pcall(function()
        LosParams.FilterType = Enum.RaycastFilterType.Exclude
    end)
    if not ok then
        pcall(function()
            LosParams.FilterType = Enum.RaycastFilterType.Blacklist
        end)
    end
    LosParams.IgnoreWater = true
    return LosParams
end

function Targeting.HasLineOfSight(target)
    local myRoot = Entity.Root()
    if not myRoot then return true end
    local params = Targeting.EnsureParams()
    local filter = {LocalPlayer.Character, target.Character}
    if WallPart then
        filter[#filter + 1] = WallPart
    end
    params.FilterDescendantsInstances = filter
    local hit = workspace:Raycast(myRoot.Position, target.Root.Position - myRoot.Position, params)
    return hit == nil
end

--═════════════════════════════════════════════════════════════ MOVEMENT ══

local Movement = {}

function Movement.Lead()
    if Config.Prediction <= 0 then return 0 end
    return Utils.clamp(Utils.ping() / 1000, 0.02, Config.MaxLead) * Config.Prediction
end

function Movement.Predict(part)
    return part.Position + part.AssemblyLinearVelocity * Movement.Lead()
end

function Movement.DropAlign()
    if not AlignRig then return end
    pcall(function() AlignRig.Position:Destroy() end)
    pcall(function() AlignRig.Orientation:Destroy() end)
    pcall(function() AlignRig.Attachment:Destroy() end)
    AlignRig = nil
end

function Movement.EnsureAlign()
    local root = Entity.Root()
    if not root then return end
    if AlignRig and AlignRig.Root == root and AlignRig.Attachment.Parent then
        return
    end
    Movement.DropAlign()

    local attachment = Instance.new("Attachment")
    attachment.Name = "HM_Align"
    attachment.Parent = root

    local alignPosition = Instance.new("AlignPosition")
    alignPosition.Mode = Enum.PositionAlignmentMode.OneAttachment
    alignPosition.Attachment0 = attachment
    alignPosition.ApplyAtCenterOfMass = true
    alignPosition.RigidityEnabled = false
    alignPosition.MaxForce = Config.AlignMaxForce
    alignPosition.Responsiveness = Config.AlignResponsiveness
    if Config.AlignMaxVelocity > 0 then
        alignPosition.MaxVelocity = Config.AlignMaxVelocity
    end
    alignPosition.Parent = root

    local alignOrientation = Instance.new("AlignOrientation")
    alignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
    alignOrientation.Attachment0 = attachment
    alignOrientation.RigidityEnabled = false
    alignOrientation.MaxTorque = Config.AlignMaxForce
    alignOrientation.Responsiveness = Config.AlignResponsiveness
    alignOrientation.Parent = root

    AlignRig = {
        Root = root,
        Attachment = attachment,
        Position = alignPosition,
        Orientation = alignOrientation,
    }
end

function Movement.StickGoal(target)
    local anchor = Entity.AimPoint(target)
    local point = Movement.Predict(anchor)
    local goal

    if Config.StickPos == "Behind" then
        goal = point
            - anchor.CFrame.LookVector * Config.StickOffset
            + Vector3.new(0, Config.StickHeight, 0)
    elseif Config.StickPos == "Front" then
        goal = point
            + anchor.CFrame.LookVector * Config.StickOffset
            + Vector3.new(0, Config.StickHeight, 0)
    elseif Config.StickPos == "Side" then
        goal = point
            + anchor.CFrame.RightVector * Config.StickOffset
            + Vector3.new(0, Config.StickHeight, 0)
    else
        goal = point + Vector3.new(0, Config.AboveHeight, 0)
    end

    return goal, point
end

function Movement.ApplyStick(target)
    local root = Entity.Root()
    if not root then return end
    local humanoid = Entity.Humanoid()

    if humanoid and Config.FreezeMove and Config.StickMode == "Physics" then
        pcall(function()
            humanoid:Move(Vector3.zero, false)
        end)
    end

    if humanoid then
        humanoid.AutoRotate = false
    end

    if Config.StickMode == "None" then
        Movement.DropAlign()
        if Config.Face then
            local flat = target.Root.Position - root.Position
            flat = Vector3.new(flat.X, 0, flat.Z)
            if flat.Magnitude > 0.4 then
                root.CFrame = CFrame.lookAt(root.Position, root.Position + flat)
            end
        end
        return
    end

    local goal, point = Movement.StickGoal(target)

    if Config.StickMode == "Physics" then
        Movement.EnsureAlign()
        if AlignRig then
            AlignRig.Position.Position = goal
            AlignRig.Orientation.CFrame = CFrame.lookAt(root.Position, point)
        end
    else
        Movement.DropAlign()
        root.CFrame = CFrame.lookAt(goal, point)
        if Config.HardKillVelocity then
            root.AssemblyLinearVelocity = Vector3.zero
        end
    end
end

function Movement.ApplyReach(target)
    local root = Entity.Root()
    if not root then return end
    if target.Distance < Config.ReachMin or target.Distance > Config.ReachMax then
        return
    end

    if Config.StickMode == "Physics" and AlignRig then
        AlignRig.Position.MaxVelocity = math.huge
        AlignRig.Position.Responsiveness = 400
        task.delay(Config.ReachTime, function()
            if AlignRig and AlignRig.Position.Parent then
                AlignRig.Position.MaxVelocity =
                    Config.AlignMaxVelocity > 0 and Config.AlignMaxVelocity or math.huge
                AlignRig.Position.Responsiveness = Config.AlignResponsiveness
            end
        end)
        return
    end

    local anchor = Entity.AimPoint(target)
    local direction = anchor.Position - root.Position
    direction = Vector3.new(direction.X, 0, direction.Z)
    if direction.Magnitude < 0.5 then return end
    local goal = anchor.Position - direction.Unit * Config.ReachSnap + Vector3.new(0, 1.5, 0)
    root.CFrame = CFrame.lookAt(goal, anchor.Position)
end

function Movement.DropWall()
    if WallPart then
        pcall(function() WallPart:Destroy() end)
        WallPart = nil
    end
end

function Movement.EnsureWall()
    if WallPart and WallPart.Parent then
        return WallPart
    end
    WallPart = Instance.new("Part")
    WallPart.Name = "HM_Wall"
    WallPart.Anchored = true
    WallPart.CanCollide = false
    WallPart.CanQuery = true
    WallPart.CanTouch = true
    WallPart.Massless = true
    WallPart.CastShadow = false
    WallPart.Material = Enum.Material.SmoothPlastic
    WallPart.Transparency = 1
    WallPart.Size = Vector3.new(Config.WallSize, Config.WallSize, 1)
    WallPart.Parent = workspace
    return WallPart
end

function Movement.UpdateWall(target)
    if not Config.WallCombo or Config.StickMode == "None" then
        Movement.DropWall()
        return
    end
    local root = Entity.Root()
    if not root then return end
    local direction = target.Root.Position - root.Position
    direction = Vector3.new(direction.X, 0, direction.Z)
    if direction.Magnitude < 0.5 then return end
    local wall = Movement.EnsureWall()
    wall.Size = Vector3.new(Config.WallSize, Config.WallSize, 1)
    wall.CFrame = CFrame.lookAt(target.Root.Position + direction.Unit * Config.WallDist, root.Position)
end

function Movement.SetNoclip(enabled)
    local character = Entity.Character()
    if not character then return end
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") and part.CanCollide then
            if enabled then
                if NoclipSaved[part] == nil then
                    NoclipSaved[part] = true
                end
                part.CanCollide = false
            elseif NoclipSaved[part] then
                part.CanCollide = true
                NoclipSaved[part] = nil
            end
        end
    end
end

function Movement.SetFly(enabled)
    local root = Entity.Root()
    local humanoid = Entity.Humanoid()
    if not root or not humanoid then return end

    if enabled then
        local bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
        bodyVelocity.Velocity = Vector3.zero
        bodyVelocity.Parent = root
        FlyBody = bodyVelocity
        humanoid.PlatformStand = false
        State.Flying = true
    else
        if FlyBody then
            FlyBody:Destroy()
            FlyBody = nil
        end
        State.Flying = false
    end
end

function Movement.StepFly()
    if not State.Flying or not FlyBody then return end
    local camera = workspace.CurrentCamera
    local root = Entity.Root()
    if not camera or not root then return end

    local direction = Vector3.zero
    if UserInput:IsKeyDown(Enum.KeyCode.W) then direction += camera.CFrame.LookVector end
    if UserInput:IsKeyDown(Enum.KeyCode.S) then direction -= camera.CFrame.LookVector end
    if UserInput:IsKeyDown(Enum.KeyCode.A) then direction -= camera.CFrame.RightVector end
    if UserInput:IsKeyDown(Enum.KeyCode.D) then direction += camera.CFrame.RightVector end
    if UserInput:IsKeyDown(Enum.KeyCode.Space) then direction += Vector3.yAxis end
    if UserInput:IsKeyDown(Enum.KeyCode.LeftControl) then direction -= Vector3.yAxis end

    if direction.Magnitude > 0 then
        FlyBody.Velocity = direction.Unit * Config.FlySpeed
    else
        FlyBody.Velocity = Vector3.zero
    end
end

