    Utils.stroke(popup, Theme.accent, 1, 0.5)
    Popups[#Popups + 1] = popup

    local color = props.default or Theme.accent
    local widget = { Value = color }

    local function apply()
        swatch.BackgroundColor3 = color
        widget.Value = color
        if props.flag then
            Config[props.flag] = color
        end
        if props.callback then
            props.callback(color)
        end
    end

    local function channelSlider(name, getter, setter, offset)
        local label = Instance.new("TextLabel")
        label.Size = UDim2.fromOffset(16, 16)
        label.Position = UDim2.fromOffset(8, offset)
        label.BackgroundTransparency = 1
        label.Font = Font.bold
        label.TextSize = 10
        label.TextColor3 = Theme.text_dim
        label.Text = name
        label.ZIndex = 21
        label.Parent = popup

        local track = Instance.new("TextButton")
        track.Size = UDim2.fromOffset(120, 6)
        track.Position = UDim2.fromOffset(28, offset + 5)
        track.BackgroundColor3 = Theme.bg_row
        track.BorderSizePixel = 0
        track.Text = ""
        track.ZIndex = 21
        track.Parent = popup
        Utils.corner(track, 3)

        local fill = Instance.new("Frame")
        fill.Size = UDim2.new(getter() / 255, 0, 1, 0)
        fill.BackgroundColor3 = Theme.accent
        fill.BorderSizePixel = 0
        fill.ZIndex = 22
        fill.Parent = track
        Utils.corner(fill, 3)

        local dragging = false
        local function fromInput(input)
            local relative = (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X
            local value = math.floor(Utils.clamp(relative, 0, 1) * 255 + 0.5)
            setter(value)
            fill.Size = UDim2.new(value / 255, 0, 1, 0)
            apply()
        end

        track.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                fromInput(input)
            end
        end)
        UserInput.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                fromInput(input)
            end
        end)
        UserInput.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)
    end

    local r, g, b = color.R * 255, color.G * 255, color.B * 255
    channelSlider("R", function() return r end, function(v) r = v end, 6)
    channelSlider("G", function() return g end, function(v) g = v end, 34)
    channelSlider("B", function() return b end, function(v) b = v end, 62)

    swatch.MouseButton1Click:Connect(function()
        local showing = not popup.Visible
        closeAllPopups(popup)
        popup.Visible = showing
        if showing then
            popup.Position = UDim2.fromOffset(
                swatch.AbsolutePosition.X - 100,
                swatch.AbsolutePosition.Y + 22
            )
        end
    end)

    apply()
    self.Widgets[#self.Widgets + 1] = widget
    return widget
end

