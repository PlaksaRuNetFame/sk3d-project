    local track = Instance.new("TextButton")
    track.Size = UDim2.new(1, 0, 0, 6)
    track.Position = UDim2.new(0, 0, 0, 20)
    track.BackgroundColor3 = Theme.bg_row
    track.BorderSizePixel = 0
    track.Text = ""
    track.Parent = row
    Utils.corner(track, 3)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = Theme.accent
    fill.BorderSizePixel = 0
    fill.Parent = track
    Utils.corner(fill, 3)

    local knob = Instance.new("Frame")
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.Size = UDim2.fromOffset(12, 12)
    knob.Position = UDim2.new(0, 0, 0.5, 0)
    knob.BackgroundColor3 = Theme.text
    knob.BorderSizePixel = 0
    knob.Parent = track
    Utils.corner(knob, 6)

    local min = props.min or 0
    local max = props.max or 100
    local decimals = props.decimals or 0
    local value = props.default or min
    if props.flag and Config[props.flag] ~= nil then
        value = Config[props.flag]
    end

    local widget = { Value = value }
    local dragging = false

    local function render()
        local ratio = (value - min) / math.max(max - min, 0.0001)
        ratio = Utils.clamp(ratio, 0, 1)
        fill.Size = UDim2.new(ratio, 0, 1, 0)
        knob.Position = UDim2.new(ratio, 0, 0.5, 0)
        valueLabel.Text = tostring(Utils.round(value, decimals))
    end

    local setter = bindFlag(props.flag)

    local function commit(newValue)
        value = Utils.clamp(newValue, min, max)
        if props.integer then
            value = math.floor(value + 0.5)
        end
        render()
        if setter then
            setter(value)
        end
        if props.callback then
            props.callback(value)
        end
    end

    local function fromInput(input)
        local relative = (input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X
        commit(min + (max - min) * Utils.clamp(relative, 0, 1))
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            fromInput(input)
        end
    end)
    UserInput.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            fromInput(input)
        end
    end)
    UserInput.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    render()

    widget.Set = function(newValue)
        commit(newValue)
    end

    self.Widgets[#self.Widgets + 1] = widget
    return widget
end

