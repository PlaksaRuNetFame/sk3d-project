local function destroyAlign()
    if not align then return end
    pcall(function() align.ap:Destroy() end)
    pcall(function() align.ao:Destroy() end)
    pcall(function() align.att:Destroy() end)
    align = nil
end

local function ensureAlign()
    local r = myHRP()
    if not r then return end
    if align and align.hrp == r and align.att.Parent then return end
    destroyAlign()
    local att = Instance.new("Attachment")
    att.Name = "HolyMolyAtt"
    att.Parent = r
    local ap = Instance.new("AlignPosition")
    ap.Mode = Enum.PositionAlignmentMode.OneAttachment
    ap.Attachment0 = att
    ap.ApplyAtCenterOfMass = true
    ap.RigidityEnabled = false
    ap.MaxForce = CFG.AlignMaxForce
    ap.Responsiveness = CFG.AlignResponsiveness
    if CFG.AlignMaxVelocity > 0 then ap.MaxVelocity = CFG.AlignMaxVelocity end
    ap.Parent = r
    local ao = Instance.new("AlignOrientation")
    ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
    ao.Attachment0 = att
    ao.RigidityEnabled = false
    ao.MaxTorque = CFG.AlignMaxForce
    ao.Responsiveness = CFG.AlignResponsiveness
    ao.Parent = r
    align = { hrp = r, att = att, ap = ap, ao = ao }
end

local function stickGoal(t)
    local ap = aimPoint(t)
    local tp = predictPos(ap)
    local pos
    if CFG.StickPos == "Behind" then
        pos = tp - ap.CFrame.LookVector * CFG.StickOffset + Vector3.new(0, CFG.StickHeight, 0)
    elseif CFG.StickPos == "Front" then
        pos = tp + ap.CFrame.LookVector * CFG.StickOffset + Vector3.new(0, CFG.StickHeight, 0)
    else
        pos = tp + Vector3.new(0, CFG.AboveHeight, 0)
    end
    return pos, tp
end

local function applyStick(t)
    local myR = myHRP()
    if not myR then return end
    local h = myHum()

    if h and CFG.FreezeMove and CFG.StickMode == "Physics" then
        pcall(function() h:Move(Vector3.zero, false) end)
    end
    if h then h.AutoRotate = false end

    if CFG.StickMode == "None" then
        destroyAlign()
        if CFG.Face then
            local flat = t.hrp.Position - myR.Position
            flat = Vector3.new(flat.X, 0, flat.Z)
            if flat.Magnitude > 0.4 then
                myR.CFrame = CFrame.lookAt(myR.Position, myR.Position + flat)
            end
        end
        return
    end

    local pos, tp = stickGoal(t)

    if CFG.StickMode == "Physics" then
        ensureAlign()
        if align then
            align.ap.Position = pos
            align.ao.CFrame = CFrame.lookAt(myR.Position, tp)
        end
    else
        destroyAlign()
        myR.CFrame = CFrame.lookAt(pos, tp)
        if CFG.HardKillVelocity then myR.AssemblyLinearVelocity = Vector3.zero end
    end
end

local function applyReach(t)
    local myR = myHRP()
    if not myR then return end
    local d = t.dist
    if d < CFG.ReachMin or d > CFG.ReachMax then return end
    if CFG.StickMode == "Physics" and align then
        align.ap.MaxVelocity = math.huge
        align.ap.Responsiveness = 400
        task.delay(CFG.ReachTime, function()
            if align and align.ap.Parent then
                align.ap.MaxVelocity = (CFG.AlignMaxVelocity > 0) and CFG.AlignMaxVelocity or math.huge
                align.ap.Responsiveness = CFG.AlignResponsiveness
            end
        end)
    else
        local ap = aimPoint(t)
        local dir = ap.Position - myR.Position
        dir = Vector3.new(dir.X, 0, dir.Z)
        if dir.Magnitude < 0.5 then return end
        local pos = ap.Position - dir.Unit * CFG.ReachSnap + Vector3.new(0, 1.5, 0)
        myR.CFrame = CFrame.lookAt(pos, ap.Position)
    end
end

local function endlagCancel()
    if not CFG.EndlagCancel then return end
    task.delay(CFG.EndlagTime, function()
        local h = myHum()
        if not h or h.PlatformStand then return end
        local st = h:GetState()
        if st == Enum.HumanoidStateType.Running
            or st == Enum.HumanoidStateType.Freefall
            or st == Enum.HumanoidStateType.Landed then
            pcall(function() h:ChangeState(Enum.HumanoidStateType.Running) end)
        end
    end)
end

local function destroyWall()
    if wallPart then
        pcall(function() wallPart:Destroy() end)
        wallPart = nil
    end
end

local function ensureWall()
    if wallPart and wallPart.Parent then return wallPart end
    wallPart = Instance.new("Part")
    wallPart.Name = "HolyMolyWall"
    wallPart.Anchored = true
    wallPart.CanCollide = false
    wallPart.CanQuery = true
    wallPart.CanTouch = true
    wallPart.Massless = true
    wallPart.CastShadow = false
    wallPart.Material = Enum.Material.SmoothPlastic
    wallPart.Transparency = 1
    wallPart.Size = Vector3.new(CFG.WallSize, CFG.WallSize, 1)
    wallPart.Parent = workspace
    return wallPart
end

local function updateWall(t)
    if not CFG.WallCombo or CFG.StickMode == "None" then
        destroyWall()
        return
    end
    local myR = myHRP()
    if not myR then return end
    local dir = t.hrp.Position - myR.Position
    dir = Vector3.new(dir.X, 0, dir.Z)
    if dir.Magnitude < 0.5 then return end
    local w = ensureWall()
    w.Size = Vector3.new(CFG.WallSize, CFG.WallSize, 1)
    w.CFrame = CFrame.lookAt(t.hrp.Position + dir.Unit * CFG.WallDist, myR.Position)
end

local function isHitboxName(n)
    n = n:lower()
    for _, k in ipairs(HB_PAT) do
        if n:find(k) then return true end
    end
    return false
end

local function expandHitbox(d)
    if CFG.HitboxScale == 1 then return end
    if not d:IsA("BasePart") then return end
    if LIMBS[d.Name] then return end
    if not isHitboxName(d.Name) then return end
    local base = d:GetAttribute("HolyHBBase")
    if not base or (base * CFG.HitboxScale - d.Size).Magnitude > 0.35 then
        base = d.Size
        pcall(function() d:SetAttribute("HolyHBBase", base) end)
    end
    d.Size = base * CFG.HitboxScale
end

local function armHitbox(d)
    expandHitbox(d)
    task.spawn(function()
        local t0 = os.clock()
        while os.clock() - t0 < CFG.HitboxTime do
            task.wait(0.03)
            if not d.Parent then break end
            expandHitbox(d)
        end
    end)
end

local function animSpeed()
    local h = myHum()
    if not h then return end
    local idle = idleAnims[LP]
    for _, tr in ipairs(h:GetPlayingAnimationTracks()) do
        local id = tr.Animation and tr.Animation.AnimationId
        if id and not (idle and idle[id]) then
            if tr.Speed ~= CFG.AnimSpeed then tr.Speed = CFG.AnimSpeed end
        end
    end
end

local function combatM1(t)
    local now = os.clock()
    if now - State.lastM1 > CFG.ComboReset then State.combo = 0 end
    if not CFG.ComboInfinite and State.combo >= CFG.ComboHits then return end
    local jit = 1 + (math.random() - 0.5) * CFG.M1Jitter
    if now - State.lastM1 >= CFG.M1Delay * jit then
        State.lastM1 = now
        State.combo = State.combo + 1
        if CFG.Reach then pcall(applyReach, t) end
        click()
        State.lastHitTarget = t.plr
        State.lastHitTime = now
        endlagCancel()
    end
end

local function feeder(t)
    if not CFG.ComboFeeder then return end
    local now = os.clock()
    if now - State.lastFeeder < CFG.FeederDelay then return end
    local rag = isRagdolled(t.char, t.hum)
    local stun = isStunned(t.char)
    if (rag and CFG.FeederOnRagdoll) or (stun and CFG.FeederOnStun) then
        State.feederIdx = (State.feederIdx % #CFG.FeederKeys) + 1
        State.lastFeeder = now
        key(CFG.FeederKeys[State.feederIdx])
    end
end

local function brain(t)
    local now = os.clock()
    if t.plr ~= State.tgtPlr then
        State.tgtPlr = t.plr
        State.combo = 0
    end

    if CFG.AutoWalk and CFG.StickMode == "None" and t.dist > 12 and now - State.lastWalk > 0.25 then
        State.lastWalk = now
        local h = myHum()
        if h then pcall(function() h:MoveTo(t.hrp.Position) end) end
    end

    if not CFG.AutoCombo then return end

    local blocking = isBlocking(t.char)
    local rag = isRagdolled(t.char, t.hum)
    local atk = isAttacking(t.plr, t.char)

    if CFG.AutoDash and not rag and t.dist > CFG.DashRange and now - State.lastDash > 0.6 then
        State.lastDash = now
        if CFG.AutoTech and CFG.StickMode ~= "None" then
            dashDir(CFG.TechKeys[math.random(#CFG.TechKeys)])
        else
            key(CFG.DashKey)
        end
    end

    if CFG.AutoDodge and t.dist < 20 and not rag and atk and now - State.lastDodge > 0.4 then
        State.lastDodge = now
        if CFG.AutoTech then
            dashDir(CFG.TechKeys[math.random(#CFG.TechKeys)])
        else
            key(CFG.DodgeKey)
        end
    end

    if CFG.AutoCounter and t.dist < CFG.CounterRange and atk and now - State.lastCounter > CFG.CounterCooldown then
        State.lastCounter = now
        key(CFG.CounterKey)
    end

    if CFG.AutoBlock and t.dist < 16 and atk and not State.blocking then
        State.blocking = true
        local kc = Enum.KeyCode[CFG.BlockKey:upper()]
        if kc then
            pcall(function() VIM:SendKeyEvent(true, kc, false, game) end)
            task.delay(0.35, function()
                pcall(function() VIM:SendKeyEvent(false, kc, false, game) end)
                State.blocking = false
            end)
        else
            State.blocking = false
        end
    end

    if CFG.ComboFeeder then
        feeder(t)
    elseif CFG.AutoSkill and now - State.lastSkill > CFG.SkillDelay then
        if (not blocking) or CFG.GuardBreakOnBlock then
            State.skillIdx = (State.skillIdx % #CFG.SkillKeys) + 1
            State.lastSkill = now
            key(CFG.SkillKeys[State.skillIdx])
        end
    end

    if CFG.Awaken and now - State.lastAwaken > CFG.AwakenDelay and ultReady() then
        State.lastAwaken = now
        key(CFG.AwakenKey)
    end

    if CFG.AutoM1 and (State.losOK or not CFG.LOSCheck) then
        combatM1(t)
    end
end

local remoteCache = nil
local function findRemote()
    if remoteCache and remoteCache.Parent then return remoteCache end
    remoteCache = nil
    if CFG.RemoteName == "" then return nil end
    for _, d in ipairs(RS:GetDescendants()) do
        if (d:IsA("RemoteEvent") or d:IsA("UnreliableRemoteEvent")) and d.Name == CFG.RemoteName then
            remoteCache = d
            return d
        end
    end
    return nil
end

local function fireRemote()
    local r = findRemote()
    local t = State.target
    if not r or not t then return end
    if CFG.RemoteArg == "player" then
        pcall(function() r:FireServer(t.plr) end)
    elseif CFG.RemoteArg == "char" then
        pcall(function() r:FireServer(t.char) end)
    elseif CFG.RemoteArg == "hrp" then
        pcall(function() r:FireServer(t.hrp) end)
    elseif CFG.RemoteArg == "pos" then
        pcall(function() r:FireServer(t.hrp.Position) end)
    else
        pcall(function() r:FireServer() end)
    end
end

