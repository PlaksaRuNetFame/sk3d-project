function Visuals.ExpandHitbox(part)
    if Config.HitboxScale == 1 then return end
    if not part:IsA("BasePart") then return end
    if LIMB_NAMES[part.Name] then return end
    if not Visuals.IsHitboxName(part.Name) then return end

