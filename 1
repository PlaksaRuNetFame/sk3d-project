function UI:Dropdown(props)
    local row = self:Row(28)
    self:RowLabel(row, props.text)

    local display = Instance.new("TextButton")
    display.AnchorPoint = Vector2.new(1, 0.5)
    display.Size = UDim2.fromOffset(120, 20)
    display.Position = UDim2.new(1, 0, 0.5, 0)
    display.BackgroundColor3 = Theme.bg_row
    display.BorderSizePixel = 0
    display.Font = Font.bold
    display.TextSize = 10
    display.TextColor3 = Theme.text
    display.Text = "..."
    display.Parent = row
    Utils.corner(display, 5)

    local popup = Instance.new("Frame")
    popup.Size = UDim2.fromOffset(120, 0)
    popup.BackgroundColor3 = Theme.bg_alt
    popup.BorderSizePixel = 0
    popup.Visible = false
    popup.ZIndex = 20
    popup.AutomaticSize = Enum.AutomaticSize.Y
    popup.Parent = self.Frame.Parent
    Utils.corner(popup, 6)
    Utils.stroke(popup, Theme.accent, 1, 0.5)

    local popupLayout = Instance.new("UIListLayout")
    popupLayout.Padding = UDim.new(0, 2)
    popupLayout.SortOrder = Enum.SortOrder.LayoutOrder
    popupLayout.Parent = popup

    local popupPad = Instance.new("UIPadding")
    popupPad.PaddingTop = UDim.new(0, 4)
    popupPad.PaddingBottom = UDim.new(0, 4)
    popupPad.PaddingLeft = UDim.new(0, 4)
    popupPad.PaddingRight = UDim.new(0, 4)
    popupPad.Parent = popup

    Popups[#Popups + 1] = popup

    local selected = {}
    local widget = { Options = props.options, Selected = selected }

    local function refreshDisplay()
        if props.multi then
            local count = 0
            for _ in pairs(selected) do count = count + 1 end
            display.Text = count > 0 and ("выбрано: " .. count) or "..."
        else
            for key in pairs(selected) do
                display.Text = tostring(key)
            end
        end
    end

    local function buildOptions()
        for _, option in ipairs(props.options) do
            local optionButton = Instance.new("TextButton")
            optionButton.Size = UDim2.new(1, 0, 0, 20)
            optionButton.BackgroundColor3 = Theme.bg_row
            optionButton.BackgroundTransparency = 0.5
            optionButton.BorderSizePixel = 0
            optionButton.Font = Font.med
            optionButton.TextSize = 10
            optionButton.TextColor3 = Theme.text_dim
            optionButton.Text = tostring(option)
            optionButton.ZIndex = 21
            optionButton.Parent = popup
            Utils.corner(optionButton, 4)

            local function paint()
                local active = selected[option] == true
                Utils.tween(optionButton, 0.12, {
                    BackgroundColor3 = active and Theme.accent_dim or Theme.bg_row,
                    TextColor3 = active and Theme.text or Theme.text_dim,
                })
            end

            optionButton.MouseButton1Click:Connect(function()
                if props.multi then
                    selected[option] = not selected[option] or nil
                else
                    table.clear(selected)
                    selected[option] = true
                    closeAllPopups()
                end
                paint()
                refreshDisplay()
                if props.flag then
                    local list = {}
                    for key in pairs(selected) do
                        list[#list + 1] = key
                    end
                    Config[props.flag] = props.multi and list or list[1]
                end
                if props.callback then
                    props.callback(selected)
                end
            end)

            if props.default then
                if type(props.default) == "table" then
                    if props.default[option] then selected[option] = true end
                elseif props.default == option then
                    selected[option] = true
                end
            end

            paint()
        end
        refreshDisplay()
    end

    buildOptions()

    display.MouseButton1Click:Connect(function()
        local showing = not popup.Visible
        closeAllPopups(popup)
        popup.Visible = showing
        if showing then
            popup.Position = UDim2.new(
                0,
                display.AbsolutePosition.X - self.Frame.AbsolutePosition.X + self.Frame.Parent.AbsolutePosition.X,
                0,
                display.AbsolutePosition.Y + display.AbsoluteSize.Y + 2
            )
        end
    end)

    self.Widgets[#self.Widgets + 1] = widget
    return widget
end

