local function pick()
    local myR = myHRP()
    if not myR then return nil end
    local myPos = myR.Position
    local best, bestKey
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and not isWhitelisted(p) then
            local c = p.Character
            if c then
                local h = humOf(c)
                local r = hrpOf(c)
                if h and r and h.Health > 0 then
                    local ok = true
                    if CFG.SafeZoneFilter and inSafe(r.Position) then ok = false end
                    if ok and CFG.ImmunityFilter and isImmune(p, h, c) then ok = false end
                    if ok then
                        local d = (r.Position - myPos).Magnitude
                        if d <= CFG.Range then
                            local key
                            if CFG.Mode == "Nearest" then key = d
                            elseif CFG.Mode == "Farthest" then key = -d
                            else key = h.Health end
                            if not bestKey or key < bestKey then
                                bestKey = key
                                best = { plr = p, char = c, hum = h, hrp = r, dist = d }
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

local losParams
local function hasLOS(t)
    local myR = myHRP()
    if not myR then return true end
    if not losParams then
        losParams = RaycastParams.new()
        losParams.FilterType = Enum.RaycastFilterType.Exclude
        losParams.IgnoreWater = true
    end
    losParams.FilterDescendantsInstances = { LP.Character, t.char, wallPart }
    local hit = workspace:Raycast(myR.Position, t.hrp.Position - myR.Position, losParams)
    return hit == nil
end

local function leadTime()
    if CFG.Prediction <= 0 then return 0 end
    return math.clamp(ping() / 1000, 0.02, CFG.MaxLead) * CFG.Prediction
end

local function predictPos(r)
    return r.Position + r.AssemblyLinearVelocity * leadTime()
end

