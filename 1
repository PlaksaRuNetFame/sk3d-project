local DRAW = { pool = {}, circle = nil, active = false }

local function espOff()
    if not DRAW.active then return end
    for _, e in ipairs(DRAW.pool) do
        e.line.Visible = false
        e.text.Visible = false
    end
    if DRAW.circle then DRAW.circle.Visible = false end
    DRAW.active = false
end

local function updateESP()
    if not (CFG.ESP and Drawing and Drawing.new) then
        espOff()
        return
    end
    local cam = workspace.CurrentCamera
    local myR = myHRP()
    if not cam or not myR then return end
    DRAW.active = true
    local vp = cam.ViewportSize
    local i = 0
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP then
            local c = p.Character
            local r = hrpOf(c)
            local h = humOf(c)
            if r and h and h.Health > 0 then
                local d = (r.Position - myR.Position).Magnitude
                if d <= CFG.DrawRange then
                    local sp, on = cam:WorldToViewportPoint(r.Position)
                    if on then
                        i = i + 1
                        local e = DRAW.pool[i]
                        if not e then
                            local ok = pcall(function()
                                local l = Drawing.new("Line")
                                l.Thickness = 1.4
                                local t = Drawing.new("Text")
                                t.Size = 13
                                t.Center = true
                                t.Outline = true
                                t.Font = 2
                                DRAW.pool[i] = { line = l, text = t }
                            end)
                            if ok then e = DRAW.pool[i] end
                        end
                        if e then
                            e.line.From = Vector2.new(vp.X / 2, vp.Y)
                            e.line.To = Vector2.new(sp.X, sp.Y)
                            e.line.Color = Color3.fromRGB(255, 105, 200)
                            e.line.Visible = true
                            e.text.Position = Vector2.new(sp.X, sp.Y - 20)
                            e.text.Text = string.format("%s | %d | %dm", p.Name, math.floor(h.Health), math.floor(d))
                            e.text.Color = Color3.fromRGB(255, 235, 250)
                            e.text.Visible = true
                        end
                    end
                end
            end
        end
    end
    for j = i + 1, #DRAW.pool do
        DRAW.pool[j].line.Visible = false
        DRAW.pool[j].text.Visible = false
    end
    if not DRAW.circle then
        pcall(function()
            local c0 = Drawing.new("Circle")
            c0.Thickness = 1.5
            c0.NumSides = 48
            c0.Color = Color3.fromRGB(120, 220, 255)
            DRAW.circle = c0
        end)
    end
    if DRAW.circle then
        local a = cam:WorldToViewportPoint(myR.Position)
        local b = cam:WorldToViewportPoint(myR.Position + Vector3.new(CFG.Range, 0, 0))
        DRAW.circle.Position = Vector2.new(a.X, a.Y)
        DRAW.circle.Radius = math.abs(b.X - a.X)
        DRAW.circle.Visible = true
    end
end

