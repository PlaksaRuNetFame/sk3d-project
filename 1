local Watchers = {}

function Watchers.Player(player)
    SpawnAt[player] = 0
    FriendCache[player] = nil

    RootMaid:Give(player.CharacterAdded:Connect(function(character)
        task.spawn(function()
            Entity.OnCharacter(player, character)
        end)
    end))

    if player.Character then
        task.spawn(function()
            Entity.OnCharacter(player, player.Character)
        end)
    end
end

function Watchers.Install()
    for _, player in ipairs(Players:GetPlayers()) do
        Watchers.Player(player)
    end

    RootMaid:Give(Players.PlayerAdded:Connect(function(player)
        Watchers.Player(player)

        task.wait(3)
        if not Runtime.Running then return end

        local isStaff = Config.StaffIds[player.UserId] or Config.StaffIds[player.Name]

        if not isStaff and Config.StaffGroup > 0 then
            local ok, rank = pcall(function()
                return player:GetRankInGroup(Config.StaffGroup)
            end)
            if ok and rank and rank >= 1 then
                isStaff = true
            end
        end

        if isStaff then
            State.StaffSeen = true
            if Config.OnStaff == "Shutdown" then
                pcall(function() game:Shutdown() end)
            elseif Config.OnStaff == "Hop" then
                Notify.Push("стафф: " .. player.Name .. " — хопаю", "warn")
                Social.ServerHop()
            else
                Notify.Push("СТАФФ: " .. player.Name, "warn")
            end
        else
            task.wait(4)
            if Runtime.Running and not player.Character and not State.StaffSeen then
                Notify.Push("возможный спектейтор: " .. player.Name, "info")
            end
        end
    end))

    RootMaid:Give(Players.PlayerRemoving:Connect(function(player)
        FriendCache[player] = nil
        IdleIds[player] = nil
        AnimSeen[player] = nil
        AttackAt[player] = nil
        SpawnAt[player] = nil

        if PlayerMaids[player] then
            PlayerMaids[player]:Clean()
            PlayerMaids[player] = nil
        end
    end))
end

