local ConfigManager = {}

function ConfigManager.Path(slot)
    return string.format(CONFIG_FILE, slot or Config.ActiveSlot)
end

function ConfigManager.Save(slot)
    local ok = Utils.safeWrite(ConfigManager.Path(slot), "return " .. Utils.serialize(Config))
    return ok
end

function ConfigManager.Load(slot)
    local contents = Utils.safeRead(ConfigManager.Path(slot))
    if not contents then return false end

    local chunk = loadstring(contents)
    if not chunk then return false end

    local ok, data = pcall(chunk)
    if not ok or type(data) ~= "table" then return false end

    for key, value in pairs(data) do
        if Config[key] ~= nil then
            Config[key] = value
        end
    end

    return true
end

function ConfigManager.Delete(slot)
    if not delfile then return end
    pcall(function()
        if isfile and isfile(ConfigManager.Path(slot)) then
            delfile(ConfigManager.Path(slot))
        end
    end)
end

ConfigManager.Load(Config.ActiveSlot)

