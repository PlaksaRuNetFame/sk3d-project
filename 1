        local healthFill = Drawing.new("Square")
        healthFill.Thickness = 1
        healthFill.Filled = true
        healthFill.Color = Color3.fromRGB(110, 230, 160)

        Esp.Pool[index] = {
            Box = box,
            Tracer = tracer,
            Name = nameText,
            Distance = distanceText,
            HealthBack = healthBack,
            HealthFill = healthFill,
        }
    end)

    if ok then return Esp.Pool[index] end
    return nil
end

function Visuals.UpdateEsp()
    if not (Config.ESP and Drawing and Drawing.new) then
        Visuals.EspHide()
        return
    end

    local camera = workspace.CurrentCamera
    local myRoot = Entity.Root()
    if not camera or not myRoot then return end

    Esp.Active = true
    local viewport = camera.ViewportSize
    local index = 0

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local ok, humanoid, root = Entity.IsAlive(player)
            if ok then
                local distance = (root.Position - myRoot.Position).Magnitude
                if distance <= Config.DrawRange then
                    local top, onTop = camera:WorldToViewportPoint(root.Position + Vector3.new(0, 3, 0))
                    local bottom = camera:WorldToViewportPoint(root.Position - Vector3.new(0, 3, 0))

                    if onTop then
                        index = index + 1
                        local entry = espEntry(index)
                        if entry then
                            local height = math.abs(bottom.Y - top.Y)
                            local width = height * 0.55
                            local center = Vector2.new((top.X + bottom.X) / 2, (top.Y + bottom.Y) / 2)

                            entry.Box.Size = Vector2.new(width, height)
                            entry.Box.Position = Vector2.new(center.X - width / 2, center.Y - height / 2)
                            entry.Box.Visible = Config.ESPBox
                            entry.Box.Color = Theme.accent

                            entry.Tracer.From = Vector2.new(viewport.X / 2, viewport.Y)
                            entry.Tracer.To = Vector2.new(bottom.X, bottom.Y)
                            entry.Tracer.Visible = Config.ESPTracer

                            entry.Name.Position = Vector2.new(center.X, top.Y - 18)
                            entry.Name.Text = player.Name
                            entry.Name.Visible = Config.ESPName

                            entry.Distance.Position = Vector2.new(center.X, bottom.Y + 4)
                            entry.Distance.Text = string.format("%dm", math.floor(distance))
                            entry.Distance.Visible = Config.ESPDistance

                            local healthRatio = humanoid.Health / humanoid.MaxHealth
                            entry.HealthBack.Size = Vector2.new(3, height)
                            entry.HealthBack.Position = Vector2.new(center.X - width / 2 - 6, center.Y - height / 2)
                            entry.HealthBack.Visible = Config.ESPHealth

                            entry.HealthFill.Size = Vector2.new(3, height * healthRatio)
                            entry.HealthFill.Position = Vector2.new(
                                center.X - width / 2 - 6,
                                center.Y - height / 2 + (height - height * healthRatio)
                            )
                            entry.HealthFill.Color = healthRatio > 0.5 and Theme.good
                                or (healthRatio > 0.25 and Theme.warn or Theme.bad)
                            entry.HealthFill.Visible = Config.ESPHealth
                        end
                    end
                end
            end
        end
    end

    for i = index + 1, #Esp.Pool do
        local entry = Esp.Pool[i]
        entry.Box.Visible = false
        entry.Tracer.Visible = false
        entry.Name.Visible = false
        entry.Distance.Visible = false
        entry.HealthBack.Visible = false
        entry.HealthFill.Visible = false
    end

    if Config.ReachCircle then
        if not ReachCircle then
            pcall(function()
                local circle = Drawing.new("Circle")
                circle.Thickness = 1.5
                circle.NumSides = 64
                circle.Color = Theme.accent_2
                ReachCircle = circle
            end)
        end
        if ReachCircle then
            local center = camera:WorldToViewportPoint(myRoot.Position)
            local edge = camera:WorldToViewportPoint(myRoot.Position + Vector3.new(Config.Range, 0, 0))
            ReachCircle.Position = Vector2.new(center.X, center.Y)
            ReachCircle.Radius = math.abs(edge.X - center.X)
            ReachCircle.Visible = true
        end
    elseif ReachCircle then
        ReachCircle.Visible = false
    end
end

